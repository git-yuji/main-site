---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import GlobeBackground from "../components/GlobeBackground.astro";

export interface Props {
  title: string;
  description: string;
  path?: string;
  ogType?: "website" | "profile";
  noindex?: boolean;
  bodyClass?: string;
}

const { title, description, path, ogType = "website", noindex = false, bodyClass } = Astro.props;
const canonical = path ? new URL(path, "https://yuyu-web.com/").href : undefined;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && (
      <>
        <meta property="og:type" content={ogType} />
        <meta property="og:site_name" content="YUYU WEB" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content="https://yuyu-web.com/og-image.png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="地球儀をあしらったYUYU WEBのイメージ" />
        <meta name="twitter:card" content="summary_large_image" />
        <link rel="canonical" href={canonical} />
      </>
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class:list={["m-0 min-w-80 bg-[#fcfcfc] text-[#19191d] antialiased [font-family:'Hiragino_Kaku_Gothic_ProN','Hiragino_Sans','Yu_Gothic',YuGothic,system-ui,sans-serif]", bodyClass]}>
    <slot />
    <GlobeBackground />
  </body>
</html>
