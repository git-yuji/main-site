<script>
  type GlobeFactory = (options: Record<string, unknown>) => {
    destroy: () => void;
  };

  let effect: { destroy: () => void } | undefined;
  const motionPreference = window.matchMedia("(prefers-reduced-motion: reduce)");

  let generation = 0;

  const destroyGlobe = () => {
    generation += 1;
    effect?.destroy();
    effect = undefined;
  };

  const initializeGlobe = async () => {
    destroyGlobe();

    const background = document.querySelector<HTMLElement>(
      "[data-globe-background]",
    );
    if (!background) return;
    if (motionPreference.matches) return;

    const currentGeneration = generation;
    try {
      const [THREE, GlobeModule] = await Promise.all([
        import("three"),
        import("vanta/dist/vanta.globe.min"),
      ]);

      // Ignore loads superseded by navigation or a motion preference change.
      if (currentGeneration !== generation || !background.isConnected || motionPreference.matches) return;

      const globeModule = GlobeModule as unknown as {
        default?: GlobeFactory | { default?: GlobeFactory };
      };
      const GLOBE =
        typeof globeModule.default === "function"
          ? globeModule.default
          : globeModule.default?.default;
      if (!GLOBE) throw new Error("Vanta Globeの読み込みに失敗しました。");

      effect = GLOBE({
        el: background,
        THREE,
        backgroundAlpha: 1,
        backgroundColor: 16579836,
        color: 5060413,
        color2: 16777215,
        gyroControls: false,
        maxDistance: 20,
        minHeight: 200,
        minWidth: 200,
        mouseControls: true,
        points: 10,
        scale: 1,
        scaleMobile: 1,
        showDots: true,
        size: 2,
        spacing: 15,
        touchControls: true,
      });
    } catch (error) {
      if (currentGeneration === generation) {
        console.error("地球背景の初期化に失敗しました。", error);
      }
    }
  };

  document.addEventListener("astro:page-load", initializeGlobe);
  document.addEventListener("astro:before-swap", destroyGlobe);
  motionPreference.addEventListener("change", initializeGlobe);
  window.addEventListener(
    "pagehide",
    () => {
      destroyGlobe();
      motionPreference.removeEventListener("change", initializeGlobe);
    },
    { once: true },
  );
</script>

<style is:global>
  [data-globe-background]::before {
    content: none;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-globe-background]::before {
      position: absolute;
      z-index: 0;
      inset: 0;
      display: block;
      content: "";
      pointer-events: none;
      background-image: url("/globe-static.svg");
      background-repeat: no-repeat;
      background-position: right -12rem center;
      background-size: min(78vw, 62rem) auto;
      opacity: 0.16;
    }

    [data-globe-background].globe-static-strong::before {
      opacity: 0.42;
    }
  }

  @media (prefers-reduced-motion: reduce) and (max-width: 700px) {
    [data-globe-background]::before {
      background-position: center;
      background-size: 46rem auto;
      opacity: 0.1;
    }

    [data-globe-background].globe-static-strong::before {
      opacity: 0.28;
    }
  }
</style>
