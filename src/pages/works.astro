---
import { serviceUrls } from "../data/serviceUrls";
import ContentLayout from "../layouts/ContentLayout.astro";

const works = [
  {
    category: "WEB TOOL",
    title: "メール設定診断",
    description:
      "ドメインを入力すると、メール送受信に関係するSPF・DMARC・MXレコードを確認できるWebツールです。設定状況と補足情報をカード形式で整理します。",
    purpose:
      "メール設定に詳しくない方にも、診断結果を確認・説明しやすい画面を目指して制作しました。",
    technologies: ["Next.js", "TypeScript", "Tailwind CSS", "Cloudflare Workers"],
    href: serviceUrls.mail,
    github: "https://github.com/git-yuji/mail-checker-app",
  },
  {
    category: "KNOWLEDGE BASE",
    title: "Tech Notes",
    description:
      "学習内容や設定手順、トラブル対応を記録する個人用の技術ナレッジ管理アプリです。カテゴリやタグ、キーワードから目的のノートを探せます。",
    purpose:
      "必要なときに知識を再利用できるよう、日々の記録を一か所に蓄積しています。",
    technologies: ["Next.js", "TypeScript", "React Markdown", "Cloudflare Workers"],
    href: serviceUrls.blog,
    github: "https://github.com/git-yuji/TechNotes",
  },
  {
    category: "TYPESCRIPT LEARNING",
    title: "TypeScript Simple Todo",
    description:
      "型定義やDOM操作、配列処理をTypeScriptで学ぶために制作した、シンプルなToDo管理アプリです。タスクの追加や一覧表示を通して、型を使った実装の基礎を確認できます。",
    purpose:
      "PHPで制作したToDoアプリを参考に、データの型や関数の役割を明確にしながらTypeScriptの基本を身につけるために制作しました。",
    technologies: ["TypeScript", "Vite", "Vitest", "HTML / CSS"],
    href: null,
    github: "https://github.com/git-yuji/typescript-simple-todo",
  },
  {
    category: "TYPESCRIPT LEARNING",
    title: "TypeScript Site Checker",
    description:
      "URLを入力するとWebサイトのHTMLを取得し、タイトルやOGP、canonical URL、画像のalt属性など、公開前に確認したい項目を診断するアプリです。",
    purpose:
      "実用的な診断機能を作りながら、TypeScriptの型設計、DOM操作、非同期処理、テストを段階的に学ぶために制作しました。",
    technologies: ["TypeScript", "Vite", "Vitest", "jsdom"],
    href: null,
    github: "https://github.com/git-yuji/typescript-site-checker",
  },
  {
    category: "PHP LEARNING",
    title: "Mini Todo",
    description:
      "フレームワークやデータベースを使わず、タスクをJSONファイルに保存するシンプルなToDo管理アプリです。追加、編集、完了切り替え、絞り込み、削除に対応しています。",
    purpose:
      "フォームの受け取りからデータの保存、HTMLの生成まで、PHPによるWebアプリケーションの基本的な流れを学ぶために制作しました。",
    technologies: ["PHP", "HTML", "CSS", "JSON"],
    href: null,
    github: "https://github.com/git-yuji/php-simple-todo",
  },
  {
    category: "PHP LEARNING",
    title: "My Bookmarks",
    description:
      "お気に入りのWebサイトを登録する、シンプルなブックマーク管理アプリです。タイトル、URL、カテゴリー、メモの入力と、送信された内容の安全な表示に対応しています。",
    purpose:
      "フォームから値を受け取り、入力内容を適切にエスケープしてHTMLへ表示する、PHPの基本的な処理を学ぶために制作しました。",
    technologies: ["PHP", "HTML", "CSS"],
    href: null,
    github: "https://github.com/git-yuji/php-bookmarks",
  },
  {
    category: "WEB MONITORING",
    title: "Web Health Monitor",
    description:
      "URLを入力すると、HTTPステータスや応答時間、SSL証明書の有効期限、基本的なメタ情報を診断し、結果を履歴として保存できるWebアプリです。",
    purpose:
      "単発のサイト診断だけでなく、時間による変化や異常に気づけるモニタリングツールを目指して制作しました。",
    technologies: ["TypeScript", "Vite", "Tailwind CSS", "Node.js"],
    href: null,
    github: "https://github.com/git-yuji/web-health-monitor",
  },
  {
    category: "REACT LEARNING",
    title: "React Simple Todo",
    description:
      "ReactとTypeScriptで制作した、シンプルなToDo管理アプリです。タスクの追加、完了・未完了の切り替え、削除に対応し、全件数と未完了の件数を表示します。",
    purpose:
      "useStateによる状態管理やpropsを通したデータの受け渡し、コンポーネントの分割など、Reactの基本を学ぶために制作しました。",
    technologies: ["React", "TypeScript", "Vite", "HTML / CSS"],
    href: null,
    github: "https://github.com/git-yuji/react-simple-todo",
  },
  {
    category: "LARAVEL LEARNING",
    title: "案件・修正依頼管理",
    description:
      "Web制作の案件と修正依頼をまとめて管理するアプリです。案件の登録や詳細表示、修正依頼の追加、対応状況の変更・絞り込みに対応し、ログインしたユーザーが自分の案件を管理できます。",
    purpose:
      "業務で感じた修正依頼の整理という課題を題材に、認証、データの関連付け、入力検証、アクセス制御など、PHP・Laravelによるバックエンド開発の基本を学ぶために制作しました。",
    technologies: ["PHP", "Laravel", "Blade", "SQLite", "PHPUnit"],
    href: null,
    github: "https://github.com/git-yuji/laravel-project-manager",
  },
];

const filters = ["すべて", "公開中", "TypeScript", "React", "PHP"];
---

<ContentLayout title="制作物 | YUYU WEB" description="日々の課題から生まれたWebサービスと、学びを形にした制作物を紹介します。" path="/works/" wide>
  <section class="works-hero" aria-labelledby="works-heading">
    <div>
      <p class="eyebrow">DESIGN · BUILD · LEARN</p>
      <h1 id="works-heading">小さな課題から、<br />使えるかたちへ<span>。</span></h1>
      <p class="hero-copy">日々の作業を、少し便利に。<br />実用的なWebサービスから、学びを深めるアプリまで。<br class="desktop-break" />考えて、作って、改善してきた制作物をまとめました。</p>
      <a class="text-link" href="#projects">制作物を探す <span aria-hidden="true">↓</span></a>
    </div>
    <aside class="hero-note" aria-label="制作物の概要">
      <span class="eyebrow">WORKS COLLECTION</span>
      <div class="collection-count">{String(works.length).padStart(2, "0")}<span>PROJECTS</span></div>
      <div class="note-bottom"><span>アイデアを、実装へ。</span><span>{works.filter(work => work.href).length} services online</span></div>
    </aside>
  </section>

  <section class="featured-section" aria-labelledby="featured-heading">
    <div class="section-heading"><div><p class="eyebrow">FEATURED WORKS</p><h2 id="featured-heading">公開中のサービス</h2></div><span class="section-caption">日々の「ちょっと便利」をつくる</span></div>
    <div class="featured-grid">
      {works.filter(work => work.href).map((work, index) => (
        <article class:list={["featured-card", { "notes-card": index === 1 }]}>
          <div class="project-art" aria-hidden="true">
            <div class="art-orbit"></div>
            <span class="art-label">{index === 0 ? "DOMAIN INSIGHT" : "YOUR KNOWLEDGE, CONNECTED"}</span>
            <div class="art-symbol">{index === 0 ? "@" : "Aa"}<span>↗</span></div>
            <div class="art-tags">{(index === 0 ? ["SPF", "DMARC", "MX"] : ["NOTES", "TAGS", "SEARCH"]).map(label => <span>{label}</span>)}</div>
          </div>
          <div class="featured-content">
            <p class="eyebrow"><span class="live-dot"></span>{work.category}</p>
            <h3>{work.title}</h3>
            <p>{work.description}</p>
            <a class="primary-link" href={work.href!} target="_blank" rel="noopener noreferrer">サービスを見る <span aria-hidden="true">↗</span><span class="sr-only">（新しいタブで開きます）</span></a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section id="projects" class="projects-section" aria-labelledby="projects-heading">
    <div class="section-heading"><div><p class="eyebrow">ALL PROJECTS</p><h2 id="projects-heading">制作の記録</h2></div><p class="project-count" aria-live="polite" aria-atomic="true"><span data-project-count>{works.length}</span> projects</p></div>
    <div class="filters" role="group" aria-label="制作物を絞り込む" hidden data-project-filters>
      {filters.map((filter, index) => <button type="button" data-filter={filter} aria-pressed={index === 0}>{filter}</button>)}
    </div>
    <div class="project-grid">
      {works.map((work, index) => (
        <article class="project-card" data-project data-technologies={work.technologies.join(",")} data-live={Boolean(work.href)}>
          <div class="card-top"><span class="eyebrow">{work.category}</span><span class="project-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span></div>
          <h3>{work.title}</h3>
          <p class="project-description">{work.description}</p>
          <details><summary>制作の背景</summary><p>{work.purpose}</p></details>
          <ul class="tech-list" aria-label={`${work.title}の使用技術`}>{work.technologies.map(technology => <li>{technology}</li>)}</ul>
          <div class="card-links">
            <a href={work.github} target="_blank" rel="noopener noreferrer" aria-label={`${work.title}のGitHub（新しいタブで開きます）`}>GitHub <span aria-hidden="true">↗</span></a>
            {work.href && <a href={work.href} target="_blank" rel="noopener noreferrer" aria-label={`${work.title}のサービス（新しいタブで開きます）`}>サービスを見る <span aria-hidden="true">↗</span></a>}
          </div>
        </article>
      ))}
    </div>
    <div class="closing-note"><span aria-hidden="true">✳</span><p>学んだことを、次の制作へ。<br /><span>これからも、少しずつ積み重ねていきます。</span></p><a class="text-link" href="/about/">プロフィールを見る ↗</a></div>
  </section>
</ContentLayout>

<script>
  function initializeFilters() {
    const controls = document.querySelector<HTMLElement>("[data-project-filters]");
    if (!controls || controls.dataset.initialized) return;
    controls.dataset.initialized = "true";
    controls.hidden = false;
    const projects = document.querySelectorAll<HTMLElement>("[data-project]");
    controls.addEventListener("click", (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>("button[data-filter]");
      if (!button) return;
      const filter = button.dataset.filter;
      let count = 0;
      projects.forEach(project => {
        const matches = filter === "すべて" || (filter === "公開中" ? project.dataset.live === "true" : project.dataset.technologies?.split(",").includes(filter ?? ""));
        project.hidden = !matches;
        if (matches) count++;
      });
      controls.querySelectorAll("button").forEach(item => item.setAttribute("aria-pressed", String(item === button)));
      const output = document.querySelector("[data-project-count]");
      if (output) output.textContent = String(count);
    });
  }
  initializeFilters();
  document.addEventListener("astro:page-load", initializeFilters);
</script>

<style>
  .eyebrow { margin: 0; font-size: .66rem; font-weight: 700; letter-spacing: .16em; color: #78666c; }
  .works-hero { display: grid; grid-template-columns: 1.5fr 1fr; align-items: center; gap: 3rem; padding: 6rem 0 5rem; }
  h1 { margin: 1.4rem 0; font-size: clamp(2.5rem, 5.5vw, 4.25rem); letter-spacing: -.065em; line-height: 1.35; } h1 > span { color: #987c83; }
  .hero-copy { color: #67616a; line-height: 2.1; font-size: .94rem; }
  .text-link { display: inline-flex; align-items: center; gap: 1.5rem; margin-top: 1rem; color: #4d373d; text-decoration: none; font-size: .8rem; font-weight: 700; }
  .hero-note { position: relative; overflow: hidden; padding: 2rem; border: 1px solid #4d373d20; border-radius: 50% 50% 1.5rem 1.5rem; background: linear-gradient(145deg, #eee5e4c9, #ffffff9c); text-align: center; }
  .hero-note > .eyebrow { display: block; margin-top: 2rem; }
  .collection-count { font-size: 7rem; font-weight: 500; line-height: 1.3; letter-spacing: -.08em; color: #4d373d; }
  .collection-count > span { display: block; font-size: .65rem; letter-spacing: .3em; }
  .note-bottom { display: grid; gap: .6rem; margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid #4d373d20; font-size: .72rem; color: #78666c; }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 1.8rem; } h2 { margin: .7rem 0 0; font-size: 1.6rem; letter-spacing: -.04em; }
  .section-caption, .project-count { color: #797079; font-size: .75rem; }
  .featured-grid, .project-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
  .featured-card { overflow: hidden; border: 1px solid #4d373d18; border-radius: 1.5rem; background: #fff; box-shadow: 0 15px 45px #4d373d08; }
  .project-art { position: relative; isolation: isolate; overflow: hidden; display: flex; flex-direction: column; justify-content: space-between; height: 15rem; padding: 1.7rem; color: #f8efec; background: #61474f; }
  .notes-card .project-art { background: #dde5df; color: #354c40; }
  .art-label { font-size: .6rem; letter-spacing: .18em; }
  .art-orbit { position: absolute; z-index: -1; width: 20rem; height: 20rem; border: 1px solid currentColor; opacity: .18; border-radius: 50%; top: -3rem; right: -3rem; box-shadow: 0 0 0 2rem #ffffff12, 0 0 0 4rem #ffffff0a; }
  .art-symbol { align-self: center; font-family: Georgia, serif; font-size: 6rem; line-height: 1; letter-spacing: -.1em; } .art-symbol > span { margin-left: 1rem; font-family: sans-serif; font-size: 2rem; vertical-align: top; }
  .art-tags { display: flex; gap: .6rem; } .art-tags > span { padding: .35rem .65rem; border: 1px solid #ffffff50; border-radius: 2rem; font-size: .55rem; letter-spacing: .12em; } .notes-card .art-tags > span { border-color: #354c4030; }
  .featured-content { padding: 2rem; } h3 { margin: .9rem 0; font-size: 1.35rem; letter-spacing: -.035em; overflow-wrap: anywhere; }
  .featured-content > p:not(.eyebrow), .project-description { color: #65616a; font-size: .85rem; line-height: 1.95; }
  .live-dot { display: inline-block; width: .4rem; height: .4rem; border-radius: 50%; background: #69846d; margin-right: .5rem; }
  .primary-link { display: flex; justify-content: space-between; padding: 1rem 0 0; margin-top: 1.5rem; border-top: 1px solid #4d373d20; color: #4d373d; font-size: .8rem; font-weight: 700; text-decoration: none; }
  .projects-section { padding-top: 5rem; scroll-margin-top: 2rem; }
  .filters { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1.5rem; } .filters[hidden], .project-card[hidden] { display: none; }
  .filters button { cursor: pointer; padding: .65rem 1.1rem; border: 1px solid #4d373d20; border-radius: 2rem; background: #ffffffaa; color: #65535b; font: inherit; font-size: .75rem; } .filters button[aria-pressed="true"] { background: #4d373d; color: white; border-color: #4d373d; }
  .project-card { display: flex; flex-direction: column; min-width: 0; padding: 1.8rem; border: 1px solid #4d373d1c; border-radius: 1.2rem; background: #ffffffdd; transition: border-color .2s, box-shadow .2s; } .project-card:hover { border-color: #4d373d50; box-shadow: 0 12px 32px #4d373d08; }
  .card-top { display: flex; align-items: center; justify-content: space-between; gap: 1rem; } .card-top .eyebrow { font-size: .58rem; } .project-number { color: #aa979d; font-family: Georgia, serif; font-size: 1.4rem; }
  .project-description { margin: 0 0 1rem; }
  details { font-size: .78rem; color: #70666b; line-height: 1.9; } summary { cursor: pointer; width: fit-content; color: #4d373d; } details p { margin: .7rem 0; }
  .tech-list { display: flex; flex-wrap: wrap; gap: .4rem; list-style: none; padding: 1.4rem 0; margin: auto 0 0; } .tech-list li { padding: .3rem .6rem; border-radius: .35rem; background: #f3f0f1; color: #6d5c64; font-size: .62rem; }
  .card-links { display: flex; justify-content: space-between; gap: 1rem; padding-top: 1rem; border-top: 1px solid #4d373d15; } .card-links a { color: #4d373d; font-size: .75rem; font-weight: 700; text-decoration: none; } .card-links a span { margin-left: .6rem; }
  a:hover { text-decoration: underline; text-underline-offset: 4px; } a:focus-visible, button:focus-visible, summary:focus-visible { outline: 3px solid #987c83; outline-offset: 5px; }
  .closing-note { display: flex; align-items: center; gap: 1.3rem; margin-top: 3rem; padding: 2rem 0; border-top: 1px solid #4d373d20; } .closing-note > span { font-size: 2.7rem; color: #987c83; } .closing-note p { font-size: .9rem; line-height: 1.9; } .closing-note p span { color: #797079; font-size: .75rem; } .closing-note a { margin: 0 0 0 auto; }
  @media (max-width: 700px) { .works-hero { grid-template-columns: 1fr; gap: 2rem; padding: 3.5rem 0; } .hero-note { display: none; } .hero-copy { font-size: .85rem; } .desktop-break { display: none; } .featured-grid, .project-grid { grid-template-columns: 1fr; } .section-caption { display: none; } .featured-content, .project-card { padding: 1.5rem; } .projects-section { padding-top: 3.5rem; } .closing-note { flex-wrap: wrap; gap: 1rem; } .closing-note a { margin: 0; flex-basis: 100%; } }
  @media (prefers-reduced-motion: reduce) { .project-card { transition: none; } }
</style>
