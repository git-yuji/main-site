---
import { serviceUrls } from "../data/serviceUrls";
import ContentLayout from "../layouts/ContentLayout.astro";

const works = [
  {
    category: "WEB TOOL",
    title: "メール設定診断",
    description:
      "ドメインを入力すると、メール送受信に関係するSPF・DMARC・MXレコードを確認できるWebツールです。設定状況と補足情報をカード形式で整理します。",
    purpose:
      "メール設定に詳しくない方にも、診断結果を確認・説明しやすい画面を目指して制作しました。",
    technologies: ["Next.js", "TypeScript", "Tailwind CSS", "Cloudflare Workers"],
    href: serviceUrls.mail,
    github: "https://github.com/git-yuji/mail-checker-app",
  },
  {
    category: "KNOWLEDGE BASE",
    title: "Tech Notes",
    description:
      "学習内容や設定手順、トラブル対応を記録する個人用の技術ナレッジ管理アプリです。カテゴリやタグ、キーワードから目的のノートを探せます。",
    purpose:
      "必要なときに知識を再利用できるよう、日々の記録を一か所に蓄積しています。",
    technologies: ["Next.js", "TypeScript", "React Markdown", "Cloudflare Workers"],
    href: serviceUrls.blog,
    github: "https://github.com/git-yuji/TechNotes",
  },
  {
    category: "TYPESCRIPT LEARNING",
    title: "TypeScript Simple Todo",
    description:
      "型定義やDOM操作、配列処理をTypeScriptで学ぶために制作した、シンプルなToDo管理アプリです。タスクの追加や一覧表示を通して、型を使った実装の基礎を確認できます。",
    purpose:
      "PHPで制作したToDoアプリを参考に、データの型や関数の役割を明確にしながらTypeScriptの基本を身につけるために制作しました。",
    technologies: ["TypeScript", "Vite", "Vitest", "HTML / CSS"],
    href: null,
    github: "https://github.com/git-yuji/typescript-simple-todo",
  },
  {
    category: "TYPESCRIPT LEARNING",
    title: "TypeScript Site Checker",
    description:
      "URLを入力するとWebサイトのHTMLを取得し、タイトルやOGP、canonical URL、画像のalt属性など、公開前に確認したい項目を診断するアプリです。",
    purpose:
      "実用的な診断機能を作りながら、TypeScriptの型設計、DOM操作、非同期処理、テストを段階的に学ぶために制作しました。",
    technologies: ["TypeScript", "Vite", "Vitest", "jsdom"],
    href: null,
    github: "https://github.com/git-yuji/typescript-site-checker",
  },
  {
    category: "PHP LEARNING",
    title: "Mini Todo",
    description:
      "フレームワークやデータベースを使わず、タスクをJSONファイルに保存するシンプルなToDo管理アプリです。追加、編集、完了切り替え、絞り込み、削除に対応しています。",
    purpose:
      "フォームの受け取りからデータの保存、HTMLの生成まで、PHPによるWebアプリケーションの基本的な流れを学ぶために制作しました。",
    technologies: ["PHP", "HTML", "CSS", "JSON"],
    href: null,
    github: "https://github.com/git-yuji/php-simple-todo",
  },
  {
    category: "PHP LEARNING",
    title: "My Bookmarks",
    description:
      "お気に入りのWebサイトを登録する、シンプルなブックマーク管理アプリです。タイトル、URL、カテゴリー、メモの入力と、送信された内容の安全な表示に対応しています。",
    purpose:
      "フォームから値を受け取り、入力内容を適切にエスケープしてHTMLへ表示する、PHPの基本的な処理を学ぶために制作しました。",
    technologies: ["PHP", "HTML", "CSS"],
    href: null,
    github: "https://github.com/git-yuji/php-bookmarks",
  },
  {
    category: "WEB MONITORING",
    title: "Web Health Monitor",
    description:
      "URLを入力すると、HTTPステータスや応答時間、SSL証明書の有効期限、基本的なメタ情報を診断し、結果を履歴として保存できるWebアプリです。",
    purpose:
      "単発のサイト診断だけでなく、時間による変化や異常に気づけるモニタリングツールを目指して制作しました。",
    technologies: ["TypeScript", "Vite", "Tailwind CSS", "Node.js"],
    href: null,
    github: "https://github.com/git-yuji/web-health-monitor",
  },
  {
    category: "REACT LEARNING",
    title: "React Simple Todo",
    description:
      "ReactとTypeScriptで制作した、シンプルなToDo管理アプリです。タスクの追加、完了・未完了の切り替え、削除に対応し、全件数と未完了の件数を表示します。",
    purpose:
      "useStateによる状態管理やpropsを通したデータの受け渡し、コンポーネントの分割など、Reactの基本を学ぶために制作しました。",
    technologies: ["React", "TypeScript", "Vite", "HTML / CSS"],
    href: null,
    github: "https://github.com/git-yuji/react-simple-todo",
  },
  {
    category: "LARAVEL LEARNING",
    title: "案件・修正依頼管理",
    description:
      "Web制作の案件と修正依頼をまとめて管理するアプリです。案件の登録や詳細表示、修正依頼の追加、対応状況の変更・絞り込みに対応し、ログインしたユーザーが自分の案件を管理できます。",
    purpose:
      "業務で感じた修正依頼の整理という課題を題材に、認証、データの関連付け、入力検証、アクセス制御など、PHP・Laravelによるバックエンド開発の基本を学ぶために制作しました。",
    technologies: ["PHP", "Laravel", "Blade", "SQLite", "PHPUnit"],
    href: null,
    github: "https://github.com/git-yuji/laravel-project-manager",
  },
];
---

<ContentLayout
  title="制作物 | YUYU WEB"
  description="YUYUが制作したWebサービスを紹介します。"
  path="/works/"
>
    <section class="mt-20 max-[700px]:mt-14" aria-labelledby="works-heading">
      <p class="m-0 text-[0.76rem] font-bold tracking-[0.18em] text-[#76767c]">WORKS</p>
      <h1
        id="works-heading"
        class="mt-4 mb-0 [font-size:clamp(2.8rem,9vw,5rem)] leading-none font-bold tracking-[-0.045em]"
      >
        制作物
      </h1>
      <p class="mt-8 mb-0 max-w-[36rem] text-[1.05rem] leading-[2] tracking-[0.025em] text-[#56565e] max-[700px]:text-base">
        日々の作業や学習を、少し便利にするために作ったWebサービスです。
      </p>
    </section>

    <div class="mt-16 grid gap-6 max-[700px]:mt-12">
      {
        works.map((work, index) => (
          <article class="rounded-[22px] border border-[#19191d]/10 bg-white/80 p-9 shadow-[0_18px_55px_rgba(40,34,36,0.08)] backdrop-blur-[16px] max-[700px]:rounded-[18px] max-[700px]:p-6">
            <div class="flex items-start justify-between gap-6">
              <p class="m-0 text-[0.72rem] font-bold tracking-[0.18em] text-[#76767c]">
                {work.category}
              </p>
              <span aria-hidden="true" class="text-[0.78rem] font-bold tracking-[0.12em] text-[#4d373d]/45">
                {String(index + 1).padStart(2, "0")}
              </span>
            </div>
            <h2 class="mt-4 mb-0 text-[1.75rem] font-bold tracking-[-0.035em]">
              {work.title}
            </h2>
            <p class="mt-5 mb-0 text-[0.93rem] leading-[1.9] text-[#56565e]">
              {work.description}
            </p>
            <p class="mt-4 mb-0 border-l-2 border-[#4d373d]/20 pl-4 text-[0.82rem] leading-[1.8] text-[#67676d]">
              {work.purpose}
            </p>
            <ul class="mt-6 mb-0 flex list-none flex-wrap gap-2 p-0" aria-label={`${work.title}の使用技術`}>
              {work.technologies.map((technology) => (
                <li class="rounded-full border border-[#19191d]/10 bg-[#fcfcfc]/85 px-3 py-[6px] text-[0.72rem] font-bold text-[#56565e]">
                  {technology}
                </li>
              ))}
            </ul>
            <div class="mt-7 flex flex-wrap gap-3 border-t border-[#19191d]/10 pt-6">
              {work.href && (
                <a
                  class="group inline-flex min-h-11 items-center gap-2 rounded-full bg-[#4d373d] px-5 text-[0.8rem] font-bold text-white no-underline transition duration-200 ease-out hover:-translate-y-0.5 hover:bg-[#39292d] focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-[#4d373d]/30 motion-reduce:transition-none"
                  href={work.href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  サービスを見る
                  <span aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 motion-reduce:transition-none">↗</span>
                </a>
              )}
              <a
                class="group inline-flex min-h-11 items-center gap-2 rounded-full border border-[#4d373d]/15 bg-white/75 px-5 text-[0.8rem] font-bold text-[#4d373d] no-underline transition duration-200 ease-out hover:-translate-y-0.5 hover:border-[#4d373d]/30 focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-[#4d373d]/30 motion-reduce:transition-none"
                href={work.github}
                target="_blank"
                rel="noopener noreferrer"
              >
                GitHub
                <span aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 motion-reduce:transition-none">↗</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>

</ContentLayout>
