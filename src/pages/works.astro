---
import { serviceUrls } from "../data/serviceUrls";
import SectionHeading from "../components/SectionHeading.astro";
import ContentLayout from "../layouts/ContentLayout.astro";

const works = [
  {
    category: "WEB TOOL",
    title: "メール設定診断",
    description:
      "ドメインを入力すると、メール送受信に関係するSPF・DMARC・MXレコードを確認できるWebツールです。設定状況と補足情報をカード形式で整理します。",
    purpose:
      "メール設定に詳しくない方にも、診断結果を確認・説明しやすい画面を目指して制作しました。",
    technologies: [
      "Next.js",
      "TypeScript",
      "Tailwind CSS",
      "Cloudflare Workers",
    ],
    href: serviceUrls.mail,
    github: "https://github.com/git-yuji/mail-checker-app",
  },
  {
    category: "KNOWLEDGE BASE",
    title: "Tech Notes",
    description:
      "学習内容や設定手順、トラブル対応を記録する個人用の技術ナレッジ管理アプリです。カテゴリやタグ、キーワードから目的のノートを探せます。",
    purpose:
      "必要なときに知識を再利用できるよう、日々の記録を一か所に蓄積しています。",
    technologies: [
      "Next.js",
      "TypeScript",
      "React Markdown",
      "Cloudflare Workers",
    ],
    href: serviceUrls.blog,
    github: "https://github.com/git-yuji/TechNotes",
  },
  {
    category: "TYPESCRIPT LEARNING",
    title: "TypeScript Simple Todo",
    description:
      "型定義やDOM操作、配列処理をTypeScriptで学ぶために制作した、シンプルなToDo管理アプリです。タスクの追加や一覧表示を通して、型を使った実装の基礎を確認できます。",
    purpose:
      "PHPで制作したToDoアプリを参考に、データの型や関数の役割を明確にしながらTypeScriptの基本を身につけるために制作しました。",
    technologies: ["TypeScript", "Vite", "Vitest", "HTML / CSS"],
    href: null,
    github: "https://github.com/git-yuji/typescript-simple-todo",
  },
  {
    category: "TYPESCRIPT LEARNING",
    title: "TypeScript Site Checker",
    description:
      "URLを入力するとWebサイトのHTMLを取得し、タイトルやOGP、canonical URL、画像のalt属性など、公開前に確認したい項目を診断するアプリです。",
    purpose:
      "実用的な診断機能を作りながら、TypeScriptの型設計、DOM操作、非同期処理、テストを段階的に学ぶために制作しました。",
    technologies: ["TypeScript", "Vite", "Vitest", "jsdom"],
    href: null,
    github: "https://github.com/git-yuji/typescript-site-checker",
  },
  {
    category: "PHP LEARNING",
    title: "Mini Todo",
    description:
      "フレームワークやデータベースを使わず、タスクをJSONファイルに保存するシンプルなToDo管理アプリです。追加、編集、完了切り替え、絞り込み、削除に対応しています。",
    purpose:
      "フォームの受け取りからデータの保存、HTMLの生成まで、PHPによるWebアプリケーションの基本的な流れを学ぶために制作しました。",
    technologies: ["PHP", "HTML", "CSS", "JSON"],
    href: null,
    github: "https://github.com/git-yuji/php-simple-todo",
  },
  {
    category: "PHP LEARNING",
    title: "My Bookmarks",
    description:
      "お気に入りのWebサイトを登録する、シンプルなブックマーク管理アプリです。タイトル、URL、カテゴリー、メモの入力と、送信された内容の安全な表示に対応しています。",
    purpose:
      "フォームから値を受け取り、入力内容を適切にエスケープしてHTMLへ表示する、PHPの基本的な処理を学ぶために制作しました。",
    technologies: ["PHP", "HTML", "CSS"],
    href: null,
    github: "https://github.com/git-yuji/php-bookmarks",
  },
  {
    category: "WEB MONITORING",
    title: "Web Health Monitor",
    description:
      "URLを入力すると、HTTPステータスや応答時間、SSL証明書の有効期限、基本的なメタ情報を診断し、結果を履歴として保存できるWebアプリです。",
    purpose:
      "単発のサイト診断だけでなく、時間による変化や異常に気づけるモニタリングツールを目指して制作しました。",
    technologies: ["TypeScript", "Vite", "Tailwind CSS", "Node.js"],
    href: null,
    github: "https://github.com/git-yuji/web-health-monitor",
  },
  {
    category: "REACT LEARNING",
    title: "React Simple Todo",
    description:
      "ReactとTypeScriptで制作した、シンプルなToDo管理アプリです。タスクの追加、完了・未完了の切り替え、削除に対応し、全件数と未完了の件数を表示します。",
    purpose:
      "useStateによる状態管理やpropsを通したデータの受け渡し、コンポーネントの分割など、Reactの基本を学ぶために制作しました。",
    technologies: ["React", "TypeScript", "Vite", "HTML / CSS"],
    href: null,
    github: "https://github.com/git-yuji/react-simple-todo",
  },
  {
    category: "LARAVEL LEARNING",
    title: "案件・修正依頼管理",
    description:
      "Web制作の案件と修正依頼をまとめて管理するアプリです。案件の登録や詳細表示、修正依頼の追加、対応状況の変更・絞り込みに対応し、ログインしたユーザーが自分の案件を管理できます。",
    purpose:
      "業務で感じた修正依頼の整理という課題を題材に、認証、データの関連付け、入力検証、アクセス制御など、PHP・Laravelによるバックエンド開発の基本を学ぶために制作しました。",
    technologies: ["PHP", "Laravel", "Blade", "SQLite", "PHPUnit"],
    href: null,
    github: "https://github.com/git-yuji/laravel-project-manager",
  },
];

const filters = ["すべて", "公開中", "TypeScript", "React", "PHP"];
---

<ContentLayout
  title="制作物 | YUYU WEB"
  description="日々の課題から生まれたWebサービスと、学びを形にした制作物を紹介します。"
  path="/works/"
  wide
>
  <section
    class="grid grid-cols-[2fr_1fr] items-center gap-12 pt-24 pb-20 max-[700px]:grid-cols-1 max-[700px]:gap-8 max-[700px]:py-14"
    aria-labelledby="works-heading"
  >
    <div>
      <p class="m-0 text-[0.76rem] font-bold tracking-[0.18em] text-[#76767c]">
        DESIGN · BUILD · LEARN
      </p>
      <h1
        id="works-heading"
        class="mt-4 mb-0 [font-size:clamp(2.8rem,5.5vw,5rem)] leading-[1.2] font-bold tracking-[-0.045em]"
      >
        小さな課題から、
        <br />
        使えるかたちへ<span class="text-[#987c83]">。</span>
      </h1>
      <p class="mt-8 mb-0 text-[1.05rem] leading-[2] tracking-[0.025em] text-[#56565e] max-[700px]:text-base">
        日々の作業を、少し便利に。
        <br />
        実用的なWebサービスから、学びを深めるアプリまで。
        <br class="max-[700px]:hidden" />
        考えて、作って、改善してきた制作物をまとめました。
      </p>
      <a
        class="mt-4 inline-flex items-center gap-6 text-[0.82rem] font-bold text-[#4d373d] no-underline hover:underline hover:underline-offset-4 focus-visible:outline-3 focus-visible:outline-offset-[5px] focus-visible:outline-[#987c83]"
        href="#projects"
      >
        制作物を探す <span aria-hidden="true">↓</span>
      </a>
    </div>
    <aside
      class="relative overflow-hidden rounded-[50%_50%_1.5rem_1.5rem] border border-[#4d373d20] bg-[linear-gradient(145deg,#eee5e4c9,#ffffff9c)] p-8 text-center max-[700px]:hidden"
      aria-label="制作物の概要"
    >
      <span class="m-0 text-[0.76rem] font-bold tracking-[0.18em] text-[#76767c] mt-8 block">
        WORKS COLLECTION
      </span>
      <div class="text-[7rem] leading-[1.3] font-bold tracking-[-0.045em] text-[#4d373d]">
        {String(works.length).padStart(2, "0")}
        <span class="block text-[0.76rem] font-bold tracking-[0.18em]">
          PROJECTS
        </span>
      </div>
      <div class="mt-8 grid gap-[0.6rem] border-t border-[#4d373d20] pt-6 text-[0.78rem] text-[#67676d]">
        <span>アイデアを、実装へ。</span>
        <span>{works.filter((work) => work.href).length} services online</span>
      </div>
    </aside>
  </section>

  <section aria-labelledby="featured-heading">
    <div class="mb-[1.8rem] flex items-end justify-between gap-4">
      <div>
        <SectionHeading id="featured-heading" label="FEATURED WORKS">
          公開中のサービス
        </SectionHeading>
      </div>
      <span class="text-[0.78rem] text-[#67676d] max-[700px]:hidden">
        日々の「ちょっと便利」をつくる
      </span>
    </div>
    <div class="grid grid-cols-2 gap-6 max-[700px]:grid-cols-1">
      {works
        .filter((work) => work.href)
        .map((work, index) => (
          <article class="overflow-hidden rounded-3xl border border-[#4d373d18] bg-white shadow-[0_15px_45px_#4d373d08]">
            <div
              class:list={[
                "relative isolate flex h-60 flex-col justify-between overflow-hidden p-[1.7rem]",
                index === 1
                  ? "bg-[#dde5df] text-[#354c40]"
                  : "bg-[#61474f] text-[#f8efec]",
              ]}
              aria-hidden="true"
            >
              <div class="absolute -top-12 -right-12 -z-1 size-80 rounded-full border border-current opacity-[0.18] shadow-[0_0_0_2rem_#ffffff12,0_0_0_4rem_#ffffff0a]"></div>
              <span class="text-[0.76rem] font-bold tracking-[0.18em]">
                {index === 0 ? "DOMAIN INSIGHT" : "YOUR KNOWLEDGE, CONNECTED"}
              </span>
              <div class="self-center text-8xl leading-none tracking-[-0.1em]">
                {index === 0 ? "@" : "Aa"}
                <span class="ml-4 align-top text-[2rem]">↗</span>
              </div>
              <div class="flex gap-[0.6rem]">
                {(index === 0
                  ? ["SPF", "DMARC", "MX"]
                  : ["NOTES", "TAGS", "SEARCH"]
                ).map((label) => (
                  <span
                    class:list={[
                      "rounded-[2rem] border px-[0.65rem] py-[0.35rem] text-[0.72rem] font-bold tracking-[0.12em]",
                      index === 1 ? "border-[#354c4030]" : "border-[#ffffff50]",
                    ]}
                  >
                    {label}
                  </span>
                ))}
              </div>
            </div>
            <div class="p-8 max-[700px]:p-6">
              <p class="m-0 text-[0.76rem] font-bold tracking-[0.18em] text-[#76767c]">
                <span class="mr-2 inline-block size-[0.4rem] rounded-full bg-[#69846d]"></span>
                {work.category}
              </p>
              <h3 class="mt-4 mb-4 text-[1.2rem] font-[750] tracking-[-0.025em] [overflow-wrap:anywhere]">
                {work.title}
              </h3>
              <p class="text-[0.95rem] leading-[1.9] text-[#56565e]">
                {work.description}
              </p>
              <a
                class="mt-6 flex justify-between border-t border-[#4d373d20] pt-4 text-[0.82rem] font-bold text-[#4d373d] no-underline hover:underline hover:underline-offset-4 focus-visible:outline-3 focus-visible:outline-offset-[5px] focus-visible:outline-[#987c83]"
                href={work.href!}
                target="_blank"
                rel="noopener noreferrer"
              >
                サービスを見る{" "}
                <span class="ml-[0.6rem]" aria-hidden="true">
                  ↗
                </span>
                <span class="sr-only">（新しいタブで開きます）</span>
              </a>
            </div>
          </article>
        ))}
    </div>
  </section>

  <section
    id="projects"
    class="scroll-mt-8 pt-20 max-[700px]:pt-14"
    aria-labelledby="projects-heading"
  >
    <div class="mb-[1.8rem] flex items-end justify-between gap-4">
      <div>
        <SectionHeading id="projects-heading" label="ALL PROJECTS">
          制作の記録
        </SectionHeading>
      </div>
      <p
        class="text-[0.78rem] text-[#67676d]"
        aria-live="polite"
        aria-atomic="true"
      >
        <span data-project-count>{works.length}</span> projects
      </p>
    </div>
    <div
      class="mb-6 flex flex-wrap gap-2 [&[hidden]]:hidden"
      role="group"
      aria-label="制作物を絞り込む"
      hidden
      data-project-filters
    >
      {filters.map((filter, index) => (
        <button
          class="cursor-pointer rounded-[2rem] border border-[#4d373d20] bg-[#ffffffaa] px-[1.1rem] py-[0.65rem] text-[0.82rem] font-bold text-[#4d373d] aria-pressed:border-[#4d373d] aria-pressed:bg-[#4d373d] aria-pressed:text-white focus-visible:outline-3 focus-visible:outline-offset-[5px] focus-visible:outline-[#987c83]"
          type="button"
          data-filter={filter}
          aria-pressed={index === 0}
        >
          {filter}
        </button>
      ))}
    </div>
    <div class="grid grid-cols-2 gap-6 max-[700px]:grid-cols-1">
      {works.map((work, index) => (
        <article
          class="flex min-w-0 flex-col rounded-[1.2rem] border border-[#4d373d1c] bg-[#ffffffdd] p-[1.8rem] transition-[border-color,box-shadow] duration-200 hover:border-[#4d373d50] hover:shadow-[0_12px_32px_#4d373d08] motion-reduce:transition-none max-[700px]:p-6 [&[hidden]]:hidden"
          data-project
          data-technologies={work.technologies.join(",")}
          data-live={Boolean(work.href)}
        >
          <div class="flex items-center justify-between gap-4">
            <span class="m-0 text-[0.76rem] font-bold tracking-[0.18em] text-[#76767c]">
              {work.category}
            </span>
            <span
              class="text-[0.78rem] font-bold tracking-[0.12em] text-[#76767c]"
              aria-hidden="true"
            >
              {String(index + 1).padStart(2, "0")}
            </span>
          </div>
          <h3 class="mt-4 mb-4 text-[1.2rem] font-[750] tracking-[-0.025em] [overflow-wrap:anywhere]">
            {work.title}
          </h3>
          <p class="mt-0 mb-4 text-[0.95rem] leading-[1.9] text-[#56565e]">
            {work.description}
          </p>
          <details class="text-[0.86rem] leading-[1.8] text-[#67676d]">
            <summary class="w-fit cursor-pointer text-[#4d373d] focus-visible:outline-3 focus-visible:outline-offset-[5px] focus-visible:outline-[#987c83]">
              制作の背景
            </summary>
            <p class="my-[0.7rem]">{work.purpose}</p>
          </details>
          <ul
            class="mt-auto mb-0 flex list-none flex-wrap gap-[0.4rem] px-0 py-[1.4rem]"
            aria-label={`${work.title}の使用技術`}
          >
            {work.technologies.map((technology) => (
              <li class="rounded-[0.35rem] bg-[#f3f0f1] px-[0.6rem] py-[0.3rem] text-[0.78rem] text-[#67676d]">
                {technology}
              </li>
            ))}
          </ul>
          <div class="flex justify-between gap-4 border-t border-[#4d373d15] pt-4">
            <a
              class="text-[0.82rem] font-bold text-[#4d373d] no-underline hover:underline hover:underline-offset-4 focus-visible:outline-3 focus-visible:outline-offset-[5px] focus-visible:outline-[#987c83]"
              href={work.github}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${work.title}のGitHub（新しいタブで開きます）`}
            >
              GitHub{" "}
              <span class="ml-[0.6rem]" aria-hidden="true">
                ↗
              </span>
            </a>
            {work.href && (
              <a
                class="text-[0.82rem] font-bold text-[#4d373d] no-underline hover:underline hover:underline-offset-4 focus-visible:outline-3 focus-visible:outline-offset-[5px] focus-visible:outline-[#987c83]"
                href={work.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${work.title}のサービス（新しいタブで開きます）`}
              >
                サービスを見る{" "}
                <span class="ml-[0.6rem]" aria-hidden="true">
                  ↗
                </span>
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
    <div class="mt-12 flex items-center gap-[1.3rem] border-t border-[#4d373d20] py-8 max-[700px]:flex-wrap max-[700px]:gap-4">
      <span class="text-[2.7rem] text-[#987c83]" aria-hidden="true">
        ✳
      </span>
      <p class="text-[0.95rem] leading-[1.9] text-[#56565e]">
        学んだことを、次の制作へ。
        <br />
        <span class="text-[0.78rem] text-[#67676d]">
          これからも、少しずつ積み重ねていきます。
        </span>
      </p>
      <a
        class="ml-auto inline-flex items-center gap-6 text-[0.82rem] font-bold text-[#4d373d] no-underline hover:underline hover:underline-offset-4 focus-visible:outline-3 focus-visible:outline-offset-[5px] focus-visible:outline-[#987c83] max-[700px]:m-0 max-[700px]:basis-full"
        href="/about/"
      >
        プロフィールを見る ↗
      </a>
    </div>
  </section>
</ContentLayout>

<script>
  function initializeFilters() {
    const controls = document.querySelector<HTMLElement>(
      "[data-project-filters]",
    );
    if (!controls || controls.dataset.initialized) return;
    controls.dataset.initialized = "true";
    controls.hidden = false;
    const projects = document.querySelectorAll<HTMLElement>("[data-project]");
    controls.addEventListener("click", (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>(
        "button[data-filter]",
      );
      if (!button) return;
      const filter = button.dataset.filter;
      let count = 0;
      projects.forEach((project) => {
        const matches =
          filter === "すべて" ||
          (filter === "公開中"
            ? project.dataset.live === "true"
            : project.dataset.technologies?.split(",").includes(filter ?? ""));
        project.hidden = !matches;
        if (matches) count++;
      });
      controls
        .querySelectorAll("button")
        .forEach((item) =>
          item.setAttribute("aria-pressed", String(item === button)),
        );
      const output = document.querySelector("[data-project-count]");
      if (output) output.textContent = String(count);
    });
  }
  initializeFilters();
  document.addEventListener("astro:page-load", initializeFilters);
</script>
