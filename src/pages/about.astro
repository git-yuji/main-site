---
import { serviceUrls } from "../data/serviceUrls";
import ContentLayout from "../layouts/ContentLayout.astro";

const technologies = [
  { name: "Astro", description: "ページ生成とサイト全体の構築" },
  { name: "TypeScript", description: "ブラウザ上の処理" },
  { name: "Tailwind CSS", description: "レイアウトとスタイリング" },
  {
    name: "Vanta.js / Three.js",
    description: "トップページの地球アニメーション",
  },
  { name: "Cloudflare Workers", description: "静的サイトの配信" },
  { name: "Wrangler", description: "ビルドとデプロイ" },
];

const links = [
  {
    title: "GitHub",
    description: "制作物とソースコード",
    href: "https://github.com/git-yuji",
  },
  {
    title: "Blog",
    description: "記事と開発記録",
    href: serviceUrls.blog,
  },
];
---

<ContentLayout
  title="プロフィール | YUYU WEB"
  description="YUYUのプロフィールと、YUYU WEBの技術構成を紹介します。"
  path="/about/"
  ogType="profile"
  background="profile"
>
    <article class="mt-20 max-[700px]:mt-14">
      <section aria-labelledby="profile-heading">
        <p class="m-0 text-[0.76rem] font-bold tracking-[0.18em] text-[#76767c]">PROFILE</p>
        <h1
          id="profile-heading"
          class="mt-4 mb-0 [font-size:clamp(2.8rem,9vw,5rem)] leading-none font-bold tracking-[-0.045em]"
        >
          YUYU
        </h1>
        <p class="mt-8 mb-0 max-w-[36rem] text-[1.05rem] leading-[2] tracking-[0.025em] text-[#56565e] max-[700px]:text-base">
          Webサイトや、日々を少し便利にする小さなツールを作っています。<br class="max-[560px]:hidden" />
          シンプルで使いやすく、長く使えるものが好きです。
        </p>
      </section>

      <section
        class="mt-20 rounded-[22px] border border-[#19191d]/10 bg-white/80 p-9 shadow-[0_18px_55px_rgba(40,34,36,0.08)] backdrop-blur-[16px] max-[700px]:mt-14 max-[700px]:rounded-[18px] max-[700px]:p-6"
        aria-labelledby="site-heading"
      >
        <p class="m-0 text-[0.76rem] font-bold tracking-[0.18em] text-[#76767c]">ABOUT THIS SITE</p>
        <h2 id="site-heading" class="mt-3 mb-0 text-[1.65rem] font-bold tracking-[-0.025em]">
          このサイトについて
        </h2>
        <p class="mt-5 mb-0 text-[0.95rem] leading-[1.9] text-[#56565e]">
          YUYU WEBは、制作したWebサービスをまとめるためのポータルサイトです。シンプルで軽快な表示を意識し、Astroを使った静的サイトとして構築しています。
        </p>
      </section>

      <section class="mt-20 max-[700px]:mt-14" aria-labelledby="technology-heading">
        <p class="m-0 text-[0.76rem] font-bold tracking-[0.18em] text-[#76767c]">TECHNOLOGY</p>
        <h2 id="technology-heading" class="mt-3 mb-0 text-[1.65rem] font-bold tracking-[-0.025em]">
          技術構成
        </h2>
        <div class="mt-7 grid grid-cols-2 gap-3 max-[600px]:grid-cols-1">
          {
            technologies.map((technology) => (
              <div class="rounded-[16px] border border-[#19191d]/10 bg-white/70 px-5 py-[18px]">
                <h3 class="m-0 text-[0.98rem] font-[750]">{technology.name}</h3>
                <p class="mt-2 mb-0 text-[0.78rem] leading-[1.65] text-[#67676d]">
                  {technology.description}
                </p>
              </div>
            ))
          }
        </div>
        <p class="mt-6 mb-0 text-[0.86rem] leading-[1.8] text-[#67676d]">
          表示速度とメンテナンスのしやすさを大切にしながら、できるだけシンプルな構成にしています。
        </p>
      </section>

      <section class="mt-20 max-[700px]:mt-14" aria-labelledby="links-heading">
        <p class="m-0 text-[0.76rem] font-bold tracking-[0.18em] text-[#76767c]">LINKS</p>
        <h2 id="links-heading" class="mt-3 mb-0 text-[1.65rem] font-bold tracking-[-0.025em]">
          リンク
        </h2>
        <div class="mt-7 grid grid-cols-2 gap-3 max-[600px]:grid-cols-1">
          {links.map((link) => (
            <a
              class="group flex min-h-[112px] items-center justify-between gap-5 rounded-[16px] border border-[#19191d]/10 bg-white/75 px-5 py-[18px] text-inherit no-underline shadow-[0_10px_35px_rgba(40,34,36,0.05)] transition duration-200 ease-out hover:-translate-y-0.5 hover:border-[#4d373d]/25 hover:shadow-[0_14px_40px_rgba(40,34,36,0.09)] focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-[#4d373d]/30 motion-reduce:transition-none"
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="grid gap-2">
                <span class="text-[1.05rem] font-[750]">{link.title}</span>
                <span class="text-[0.78rem] leading-[1.65] text-[#67676d]">{link.description}</span>
              </span>
              <span
                aria-hidden="true"
                class="text-[1.05rem] font-bold text-[#4d373d] transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 motion-reduce:transition-none"
              >↗</span>
            </a>
          ))}
        </div>
      </section>
    </article>

</ContentLayout>
